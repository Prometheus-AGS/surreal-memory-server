+        let mut storage = embedded_storage_with_permits(1).await;
+        storage.connection_info.config.retry.operation_deadline_ms = 300;
+        let storage = Arc::new(storage);
+
+        // Another task holds the only permit.
+        let (release_tx, release_rx) = tokio::sync::oneshot::channel::<()>();
+        let (held_tx, held_rx) = tokio::sync::oneshot::channel::<()>();
+        let holder = {
+            let storage = Arc::clone(&storage);
+            tokio::spawn(async move {
+                let _lease = storage.lease().await.expect("holder lease");
+                held_tx.send(()).unwrap();
+                release_rx.await.unwrap();
+            })
+        };
+        held_rx.await.unwrap();
+
+        // add_memory never goes through retry_operation, so this proves the
+        // admission is applied outside create_record, and that the permit
+        // wait is bounded by the operation deadline.
+        let start = std::time::Instant::now();
+        let blocked = storage.add_memory(memory(0)).await;
+        let waited = start.elapsed();
+        let err = blocked.expect_err("add_memory must not run while the permit is held");
+        assert!(
+            err.to_string().contains("admission wait exceeded"),
+            "expected a deadline-bounded admission error, got: {err:#}"
+        );
+        assert!(
+            waited >= Duration::from_millis(250) && waited < Duration::from_secs(5),
+            "admission wait must be bounded by the 300ms deadline, took {waited:?}"
+        );
+
+        release_tx.send(()).unwrap();
+        holder.await.unwrap();
+        let stored = storage
+            .add_memory(memory(1))
+            .await
+            .expect("add_memory succeeds once the permit is free");
+        assert!(stored.id.is_some());
