+/// Interactive readers run a fixed number of hybrid searches while heavy
+/// writers loop until the readers finish. Returns (readers, heavy writers).
+async fn run_heavy_vs_read(
+    storage: Arc<SurrealStorage>,
+    readers: usize,
+    reads_per_reader: usize,
+    writers: usize,
+) -> (Report, Report) {
+    let stop = Arc::new(AtomicBool::new(false));
+    let mut heavy = Vec::with_capacity(writers);
+    for t in 0..writers {
+        let storage = Arc::clone(&storage);
+        let stop = Arc::clone(&stop);
+        heavy.push(tokio::spawn(async move {
+            let cycle = [Op::Conversation, Op::MindmapNode, Op::Compress];
+            let mut local = Vec::new();
+            let mut i = 0usize;
+            while !stop.load(Ordering::Relaxed) {
+                let op = cycle[i % cycle.len()];
+                let started = Instant::now();
+                let result = run_op(&storage, op, t, i).await;
+                local.push((op, started.elapsed(), result));
+                i += 1;
             }
+            local
+        }));
+    }
+    // Let the heavy writers reach steady state before reads start.
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    let reads = run_workload(
+        Arc::clone(&storage),
+        readers,
+        reads_per_reader,
+        &[Op::HybridSearch],
+    )
+    .await;
+    stop.store(true, Ordering::Relaxed);
+    (reads, collect(heavy).await)
+}
