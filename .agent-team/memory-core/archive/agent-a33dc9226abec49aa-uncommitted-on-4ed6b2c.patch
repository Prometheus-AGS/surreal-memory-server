+    async fn test_embedded_admission_one_permit_no_overlap_no_deadlock() {
+        let storage = Arc::new(embedded_storage_with_permits(1).await);
+        let done = Arc::new(std::sync::atomic::AtomicBool::new(false));
+
+        // Sample how many tasks hold database access at once.
+        let sampler = {
+            let sessions = Arc::clone(&storage.sessions);
+            let done = Arc::clone(&done);
+            tokio::spawn(async move {
+                let mut max_seen = 0usize;
+                while !done.load(std::sync::atomic::Ordering::Relaxed) {
+                    max_seen = max_seen.max(sessions.admitted_tasks());
+                    tokio::task::yield_now().await;
+                }
+                max_seen
+            })
+        };
+
+        // add_memory nests search_memories → get_all_memories while it holds
+        // a lease; with one permit, non-reentrant admission would deadlock.
+        let mut writers = Vec::new();
+        for i in 0..8 {
+            let storage = Arc::clone(&storage);
+            writers.push(tokio::spawn(
+                async move { storage.add_memory(memory(i)).await },
+            ));
+        }
+        for writer in writers {
+            writer
+                .await
+                .expect("writer task")
+                .expect("add_memory under a one-permit cap");
+        }
+        done.store(true, std::sync::atomic::Ordering::Relaxed);
+        let max_seen = sampler.await.unwrap();
+        assert!(max_seen <= 1, "{max_seen} tasks held database access at once");
+        assert_eq!(storage.sessions.admitted_tasks(), 0, "all permits released");
+    }
