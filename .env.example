# SurrealDB Configuration
SURREAL_MODE=embedded
SURREAL_PATH=./data/memory.db
SURREAL_NAMESPACE=memory
SURREAL_DATABASE=mcp

# For server mode (optional)
SURREAL_MODE=server
SURREAL_ENDPOINT=ws://localhost:8000
SURREAL_USERNAME=root
SURREAL_PASSWORD=root

# ============================================
# Embedding Provider Configuration
# Choose one: local, openai, cohere
# ============================================

# Option 1: Local Embeddings (Default - No API key needed)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=./models

# Available local models:
# - BAAI/bge-small-en-v1.5 (384 dim, fast, recommended)
# - BAAI/bge-base-en-v1.5 (768 dim, balanced)
# - BAAI/bge-large-en-v1.5 (1024 dim, best quality)
# - sentence-transformers/all-MiniLM-L6-v2 (384 dim, very fast)
# - sentence-transformers/all-MiniLM-L12-v2 (384 dim, good quality)

# Option 2: OpenAI Embeddings
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option 3: Cohere Embeddings
# EMBEDDING_PROVIDER=cohere
# COHERE_API_KEY=...
# COHERE_EMBEDDING_MODEL=embed-english-v3.0
