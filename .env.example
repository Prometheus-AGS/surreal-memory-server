# Defaults shown are the values the server uses when a variable is unset
# (src/main.rs, src/config.rs). Certified against SurrealDB 3.3.0.

# ============================================
# SurrealDB
# ============================================
# Server mode: connect to a SurrealDB 3.3.0 server
# (docker-compose exposes it on 28000; the native LaunchAgent binds 127.0.0.1:28000).
SURREAL_MODE=server
SURREAL_ENDPOINT=ws://127.0.0.1:28000
SURREAL_USERNAME=root
SURREAL_PASSWORD=root
# SURREAL_AUTH_LEVEL=root            # root | namespace | database
# Defaults: SURREAL_NAMESPACE=memory, SURREAL_DATABASE=mcp
SURREAL_NAMESPACE=memory
SURREAL_DATABASE=mcp

# Embedded mode (default when SURREAL_MODE is unset): a local RocksDB path.
# Only one process may open an embedded path at a time.
# SURREAL_MODE=embedded
# SURREAL_PATH=./data/memory.db      # default: ./data/memory.db
# SURREAL_EMBEDDED_MAX_INFLIGHT=16

# Connection retries and deadlines
# SURREAL_MAX_CONNECT_RETRIES=10
# SURREAL_MAX_OPERATION_RETRIES=3
# SURREAL_BASE_RETRY_DELAY_MS=100
# SURREAL_MAX_RETRY_DELAY_MS=5000
# SURREAL_RETRY_JITTER_FACTOR=0.25
# SURREAL_OPERATION_DEADLINE_MS=30000
# SURREAL_QUERY_TIMEOUT_MS=10000

# ============================================
# HTTP / MCP transport
# ============================================
# The REST and MCP endpoints have no authentication. Bind to loopback unless
# something else (a proxy, a container network) controls access.
# Defaults: API_HOST=0.0.0.0, API_PORT=3001
API_HOST=127.0.0.1
API_PORT=3001
# MCP_STDIO=true                     # default: true; set false for HTTP-only daemons

# ============================================
# Embedding Provider Configuration
# Choose one: local, openai, cohere
# ============================================

# Option 1: Local Embeddings (Default - No API key needed)
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=./models
# LOCAL_EMBEDDING_BACKEND=candle     # candle | mlx (Apple Silicon only)
# LOCAL_EMBEDDING_EXECUTOR=/usr/local/bin/surreal-memory-mlx-executor
# LOCAL_EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
# LOCAL_EMBEDDING_DIMENSIONS=384
# LOCAL_EMBEDDING_DEVICE=auto        # auto | cpu (candle)
# MODEL_DOWNLOAD_TIMEOUT_SECS=600
# EMBEDDING_WARMUP=true
# SURREAL_EXECUTOR_STARTUP_MS=300000
# SURREAL_EXECUTOR_WATCHDOG_MS=30000

# Available local models:
# - BAAI/bge-small-en-v1.5 (384 dim, fast, recommended)
# - BAAI/bge-base-en-v1.5 (768 dim, balanced)
# - BAAI/bge-large-en-v1.5 (1024 dim, best quality)
# - sentence-transformers/all-MiniLM-L6-v2 (384 dim, very fast)
# - sentence-transformers/all-MiniLM-L12-v2 (384 dim, good quality)

# Option 2: OpenAI Embeddings
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Option 3: Cohere Embeddings
# EMBEDDING_PROVIDER=cohere
# COHERE_API_KEY=...
# COHERE_EMBEDDING_MODEL=embed-english-v3.0

# ============================================
# Workers
# ============================================
# TTL_INTERVAL_SECS=3600
